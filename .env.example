# Copy to .env.local and fill in. Never commit .env.local.

# AI chat (required for "Ask my portfolio"; the site degrades gracefully without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: shared rate limiting (falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: raises the GitHub API rate limit for `npm run sync`
GITHUB_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
